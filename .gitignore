!app/src/**/build/
app/.cxx/
local.properties
*.iml
.idea/
.DS_Store
captures/
app/build/
*.litertlm
*.hprof
models/

.trae/

# Model weights, tokenizers and MediaPipe task bundles (*.litertlm is listed above).
*.tflite
*.task
sentencepiece*.model

# Signing material and release artifacts.
*.jks
*.keystore
*.apk
*.aab

# Local agent tooling state and worktrees.
.claude/

# Memory bench output (lab/memory). Only the committed 20261107 run is tracked; other runs are local.
lab/memory/results/*
!lab/memory/results/20261107/

# Lab bench leftovers: Python bytecode from lab/scripts, and local scratch outputs.
__pycache__/
*.pyc
